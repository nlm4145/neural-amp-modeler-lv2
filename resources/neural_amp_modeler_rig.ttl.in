@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .

<@NAM_RIG_LV2_ID@-pedal-model>
	a lv2:Parameter ; rdfs:label "Pedal Model" ; rdfs:range atom:Path .
<@NAM_RIG_LV2_ID@-amp-model>
	a lv2:Parameter ; rdfs:label "Amp Model" ; rdfs:range atom:Path .
<@NAM_RIG_LV2_ID@-cab-model>
	a lv2:Parameter ; rdfs:label "Cab Model" ; rdfs:range atom:Path .
<@NAM_RIG_LV2_ID@-cab2-model>
	a lv2:Parameter ; rdfs:label "Cab B Model" ; rdfs:range atom:Path .
<@NAM_RIG_LV2_ID@-amp2-model>
	a lv2:Parameter ; rdfs:label "Amp B Model (Morph)" ; rdfs:range atom:Path .
<@NAM_RIG_LV2_ID@-cab3-model>
	a lv2:Parameter ; rdfs:label "Cab C IR" ; rdfs:range atom:Path .
<@NAM_RIG_LV2_ID@-cab4-model>
	a lv2:Parameter ; rdfs:label "Cab D IR" ; rdfs:range atom:Path .

<@NAM_RIG_LV2_ID@-transformer-ratio>
	a units:Unit ; rdfs:label "Ratio" ; units:symbol "x" ; units:render "%f x" .

<@NAM_RIG_LV2_ID@>
	a lv2:Plugin, lv2:SimulatorPlugin, doap:Project ;
	doap:name "Axe FX" ;
	doap:license <http://opensource.org/licenses/gpl-3-0> ;
	doap:maintainer [ foaf:name "Mike Oliphant / local rig extension" ] ;
	lv2:requiredFeature urid:map, work:schedule ;
	lv2:optionalFeature lv2:hardRTCapable, opts:options, state:threadSafeRestore ;
	lv2:extensionData work:interface, state:interface, opts:interface ;
	opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ;
	patch:writable
		<@NAM_RIG_LV2_ID@-pedal-model>,
		<@NAM_RIG_LV2_ID@-amp-model>,
		<@NAM_RIG_LV2_ID@-cab-model>,
		<@NAM_RIG_LV2_ID@-cab2-model>,
		<@NAM_RIG_LV2_ID@-amp2-model>,
		<@NAM_RIG_LV2_ID@-cab3-model>,
		<@NAM_RIG_LV2_ID@-cab4-model> ;

	lv2:port [
		a atom:AtomPort, lv2:InputPort ; atom:bufferType atom:Sequence ;
		atom:supports patch:Message, midi:MidiEvent ; lv2:designation lv2:control ;
		lv2:index 0 ; lv2:symbol "control" ; lv2:name "Control"
	], [
		a atom:AtomPort, lv2:OutputPort ; atom:bufferType atom:Sequence ;
		atom:supports patch:Message ; lv2:designation lv2:control ;
		lv2:index 1 ; lv2:symbol "notify" ; lv2:name "Notify"
	], [
		a lv2:InputPort, lv2:AudioPort ;
		lv2:index 2 ; lv2:symbol "input" ; lv2:name "Input"
	], [
		a lv2:OutputPort, lv2:AudioPort ;
		lv2:index 3 ; lv2:symbol "output" ; lv2:name "Output"
	], [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 4 ; lv2:symbol "input_level" ; lv2:name "Input Lvl" ;
		lv2:default 0.0 ; lv2:minimum -20.0 ; lv2:maximum 20.0 ; units:unit units:db
	], [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 5 ; lv2:symbol "output_level" ; lv2:name "Output Lvl" ;
		lv2:default 0.0 ; lv2:minimum -20.0 ; lv2:maximum 20.0 ; units:unit units:db
	], [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 6 ; lv2:symbol "quality_scale" ; lv2:name "Quality" ;
		lv2:default 1.0 ; lv2:minimum 1.0 ; lv2:maximum 1.0
	], [
		a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "pedal_enabled" ; lv2:name "Pedal On" ;
		lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled, lv2:integer
	], [
		a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "amp_enabled" ; lv2:name "Amp On" ;
		lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled, lv2:integer
	], [
		a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "cab_enabled" ; lv2:name "Cab On" ;
		lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled, lv2:integer
	], [
		a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "auto_cab" ; lv2:name "Auto Cab" ;
		lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled, lv2:integer
	], [
		a lv2:ControlPort, lv2:OutputPort ; lv2:index 11 ; lv2:symbol "cab_auto_bypassed" ; lv2:name "Cab Auto Bypassed" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled, lv2:integer
	], [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 12 ; lv2:symbol "bass" ; lv2:name "Bass" ;
		lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 12.0 ; units:unit units:db
	], [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 13 ; lv2:symbol "mid" ; lv2:name "Mid" ;
		lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 12.0 ; units:unit units:db
	], [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 14 ; lv2:symbol "treble" ; lv2:name "Treble" ;
		lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 12.0 ; units:unit units:db
	], [
		a lv2:ControlPort, lv2:InputPort ;
		lv2:index 15 ; lv2:symbol "gate_threshold" ; lv2:name "Gate Threshold" ;
		lv2:default -27.0 ; lv2:minimum -80.0 ; lv2:maximum 0.0 ; units:unit units:db
	], [
		a lv2:ControlPort, lv2:InputPort ; lv2:index 16 ; lv2:symbol "tuner_enable" ; lv2:name "Tuner On" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled, lv2:integer
	], [
		a lv2:ControlPort, lv2:OutputPort ;
		lv2:index 17 ; lv2:symbol "tuner_note" ; lv2:name "Tuner Note" ;
		lv2:default -1.0 ; lv2:minimum -1.0 ; lv2:maximum 96.0
	], [
		a lv2:ControlPort, lv2:OutputPort ;
		lv2:index 18 ; lv2:symbol "tuner_cents" ; lv2:name "Tuner Cents" ;
		lv2:default 0.0 ; lv2:minimum -50.0 ; lv2:maximum 50.0
				], [
					a lv2:ControlPort, lv2:InputPort ;
					lv2:index 19 ; lv2:symbol "oversample_mode" ; lv2:name "Oversample Mode (legacy global)" ;
					lv2:default 2.0 ; lv2:minimum 0.0 ; lv2:maximum 2.0 ; lv2:portProperty lv2:integer ;
					lv2:scalePoint [ rdfs:value 0.0 ; rdfs:label "Off" ] ,
						[ rdfs:value 2.0 ; rdfs:label "True 2x" ]
				], [
					a lv2:ControlPort, lv2:InputPort ;
					lv2:index 20 ; lv2:symbol "pedal_oversample" ; lv2:name "Pedal Oversample" ;
					lv2:default 6.0 ; lv2:minimum 0.0 ; lv2:maximum 7.0 ; lv2:portProperty lv2:integer ;
					lv2:scalePoint [ rdfs:value 0.0 ; rdfs:label "None" ] ,
						[ rdfs:value 4.0 ; rdfs:label "True 2x" ] ,
						[ rdfs:value 5.0 ; rdfs:label "True 4x" ] ,
						[ rdfs:value 6.0 ; rdfs:label "True 8x" ] ,
						[ rdfs:value 7.0 ; rdfs:label "True 16x" ]
				], [
					a lv2:ControlPort, lv2:InputPort ;
					lv2:index 21 ; lv2:symbol "amp_oversample" ; lv2:name "Amp Oversample" ;
					lv2:default 6.0 ; lv2:minimum 0.0 ; lv2:maximum 7.0 ; lv2:portProperty lv2:integer ;
					lv2:scalePoint [ rdfs:value 0.0 ; rdfs:label "None" ] ,
						[ rdfs:value 4.0 ; rdfs:label "True 2x" ] ,
						[ rdfs:value 5.0 ; rdfs:label "True 4x" ] ,
						[ rdfs:value 6.0 ; rdfs:label "True 8x" ] ,
						[ rdfs:value 7.0 ; rdfs:label "True 16x" ]
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 22 ;
					lv2:symbol "amp_drive" ; lv2:name "Amp Drive" ;
					lv2:default 0.0 ; lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 23 ;
					lv2:symbol "gate_release" ; lv2:name "Gate Release" ;
					lv2:default 20.0 ; lv2:minimum 20.0 ; lv2:maximum 1000.0 ; units:unit units:ms
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 24 ;
					lv2:symbol "ir_normalization" ; lv2:name "IR Normalization" ;
					# Keep legacy bounds so hosts can restore 0/3 for DSP fallback to Loudness.
					lv2:default 2.0 ; lv2:minimum 0.0 ; lv2:maximum 3.0 ; lv2:portProperty lv2:integer, lv2:enumeration ;
					lv2:scalePoint [ rdfs:value 1.0 ; rdfs:label "Peak" ] ,
						[ rdfs:value 2.0 ; rdfs:label "Loudness" ]
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 25 ;
					lv2:symbol "cab_level" ; lv2:name "Cab A Level" ;
					lv2:default 0.0 ; lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db ;
					lv2:scalePoint [ rdfs:value -24.0 ; rdfs:label "Off" ]
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 26 ;
					lv2:symbol "cab_low_cut" ; lv2:name "Cab Low Cut" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 200.0 ; units:unit units:hz
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 27 ;
					lv2:symbol "cab_high_cut" ; lv2:name "Cab High Cut" ;
					lv2:default 20000.0 ; lv2:minimum 4000.0 ; lv2:maximum 20000.0 ; units:unit units:hz
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 28 ;
					lv2:symbol "compressor" ; lv2:name "Compressor" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:OutputPort ; lv2:index 29 ;
					lv2:symbol "latency" ; lv2:name "Latency" ;
					lv2:designation lv2:latency ;
					lv2:portProperty lv2:reportsLatency, lv2:integer ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 256.0 ; units:unit units:frame
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 30 ;
					lv2:symbol "transformer_type" ; lv2:name "Output Transformer" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 12.0 ; lv2:portProperty lv2:integer ;
					lv2:scalePoint [ rdfs:value 0.0 ; rdfs:label "Captured / Off" ] ,
						[ rdfs:value 1.0 ; rdfs:label "Modern Iron" ] ,
						[ rdfs:value 2.0 ; rdfs:label "US Vintage" ] ,
						[ rdfs:value 3.0 ; rdfs:label "UK Vintage" ] ,
						[ rdfs:value 4.0 ; rdfs:label "Small Iron" ] ,
						[ rdfs:value 5.0 ; rdfs:label "Tight Metal" ] ,
						[ rdfs:value 6.0 ; rdfs:label "Extended Range" ] ,
						[ rdfs:value 7.0 ; rdfs:label "Thrash Bite" ] ,
						[ rdfs:value 8.0 ; rdfs:label "Doom Iron" ] ,
						[ rdfs:value 9.0 ; rdfs:label "Studio Linear" ] ,
						[ rdfs:value 10.0 ; rdfs:label "Tweed Bloom" ] ,
						[ rdfs:value 11.0 ; rdfs:label "Class-A Chime" ] ,
						[ rdfs:value 12.0 ; rdfs:label "Bass Iron" ]
				], [
					a lv2:OutputPort, lv2:AudioPort ;
					lv2:index 31 ; lv2:symbol "output_r" ; lv2:name "Output R"
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 32 ;
					lv2:symbol "stereo_width" ; lv2:name "Cab Width" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 33 ;
					lv2:symbol "room" ; lv2:name "Room" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 34 ;
					lv2:symbol "presence" ; lv2:name "Presence" ;
					lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 12.0 ; units:unit units:db
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 35 ;
					lv2:symbol "depth" ; lv2:name "Depth" ;
					lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 12.0 ; units:unit units:db
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 36 ;
					lv2:symbol "sag" ; lv2:name "Sag" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 37 ;
					lv2:symbol "bias" ; lv2:name "Bias" ;
					lv2:default 0.0 ; lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 38 ;
					lv2:symbol "negative_feedback" ; lv2:name "Negative Feedback" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 39 ;
					lv2:symbol "bright" ; lv2:name "Bright" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 40 ;
					lv2:symbol "input_eq" ; lv2:name "Input EQ" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 41 ;
					lv2:symbol "master" ; lv2:name "Master" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 42 ;
					lv2:symbol "speaker_profile" ; lv2:name "Speaker Load Profile" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 7.0 ; lv2:portProperty lv2:integer ;
					lv2:scalePoint [ rdfs:value 0.0 ; rdfs:label "Captured / Off" ] ,
						[ rdfs:value 1.0 ; rdfs:label "Auto" ] ,
						[ rdfs:value 2.0 ; rdfs:label "Resistive" ] ,
						[ rdfs:value 3.0 ; rdfs:label "Open Back" ] ,
						[ rdfs:value 4.0 ; rdfs:label "Vintage Alnico" ] ,
						[ rdfs:value 5.0 ; rdfs:label "UK 4x12" ] ,
						[ rdfs:value 6.0 ; rdfs:label "Modern 4x12" ] ,
						[ rdfs:value 7.0 ; rdfs:label "Bass" ]
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 43 ;
					lv2:symbol "speaker_drive" ; lv2:name "Speaker Drive" ;
					lv2:default 25.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 44 ;
					lv2:symbol "speaker_compression" ; lv2:name "Speaker Compression" ;
					lv2:default 25.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 45 ;
					lv2:symbol "speaker_thump" ; lv2:name "Speaker Thump" ;
					lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 46 ;
					lv2:symbol "speaker_resonance" ; lv2:name "Speaker Resonance" ;
					lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 47 ;
					lv2:symbol "cab2_enabled" ; lv2:name "Cab B On" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled, lv2:integer
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 48 ;
					lv2:symbol "cab2_level" ; lv2:name "Cab B Level" ;
					lv2:default 0.0 ; lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db ;
					lv2:scalePoint [ rdfs:value -24.0 ; rdfs:label "Off" ]
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 49 ;
					lv2:symbol "cab2_delay" ; lv2:name "Cab Alignment" ;
					lv2:default 0.0 ; lv2:minimum -10.0 ; lv2:maximum 10.0 ; units:unit units:ms ;
					rdfs:comment "Negative delays Cab A; positive delays Cab B. Zero adds no user delay; pipeline latency compensation is unchanged."
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 50 ;
					lv2:symbol "delay_time" ; lv2:name "Delay Time" ;
					lv2:default 400.0 ; lv2:minimum 20.0 ; lv2:maximum 2000.0 ; units:unit units:ms
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 51 ;
					lv2:symbol "delay_feedback" ; lv2:name "Delay Feedback" ;
					lv2:default 35.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 52 ;
					lv2:symbol "delay_damping" ; lv2:name "Delay Damping" ;
					lv2:default 40.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 53 ;
					lv2:symbol "delay_mix" ; lv2:name "Delay Mix" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 54 ;
					lv2:symbol "reverb_mix" ; lv2:name "Reverb Mix" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 55 ;
					lv2:symbol "reverb_decay" ; lv2:name "Reverb Decay" ;
					lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 56 ;
					lv2:symbol "reverb_size" ; lv2:name "Reverb Size" ;
					lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 57 ;
					lv2:symbol "reverb_damping" ; lv2:name "Reverb Damping" ;
					lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:pc
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 58 ;
					lv2:symbol "reverb_predelay" ; lv2:name "Reverb Pre-Delay" ;
					lv2:default 10.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ; units:unit units:ms
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 59 ;
					lv2:symbol "cab2_polarity" ; lv2:name "Cab B Polarity" ;
					lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
					lv2:portProperty lv2:toggled, lv2:integer ;
					lv2:scalePoint [ rdfs:value 0.0 ; rdfs:label "Normal" ],
						[ rdfs:value 1.0 ; rdfs:label "Inverted" ]
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 60 ;
					lv2:symbol "transformer_low_cut" ; lv2:name "Transformer Low Cut Ratio" ;
					lv2:default 1.0 ; lv2:minimum 0.25 ; lv2:maximum 4.0 ;
					units:unit <@NAM_RIG_LV2_ID@-transformer-ratio> ; lv2:portProperty pprops:logarithmic
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 61 ;
					lv2:symbol "transformer_high_cut" ; lv2:name "Transformer High Cut Ratio" ;
					lv2:default 1.0 ; lv2:minimum 0.25 ; lv2:maximum 4.0 ;
					units:unit <@NAM_RIG_LV2_ID@-transformer-ratio> ; lv2:portProperty pprops:logarithmic
				], [
					a lv2:ControlPort, lv2:InputPort ; lv2:index 62 ;
					lv2:symbol "transformer_drive" ; lv2:name "Transformer Drive Ratio" ;
					lv2:default 1.0 ; lv2:minimum 0.25 ; lv2:maximum 4.0 ;
					units:unit <@NAM_RIG_LV2_ID@-transformer-ratio> ; lv2:portProperty pprops:logarithmic
